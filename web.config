<configuration>
  <system.webServer>
    <handlers>
        <add name="PythonFastCGI2" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\inetpub\QRcodesystem\qr_trip_project\.venv\Scripts\python.exe|C:\inetpub\QRcodesystem\qr_trip_project\.venv\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <defaultDocument>
      <files>
        <add value="index.py" />
      </files>
    </defaultDocument>
  </system.webServer>
  <appSettings>
    <add key="WSGI_HANDLER" value="qr_trip_project.wsgi.application" />
    <add key="PYTHONPATH" value="C:\inetpub\QRcodesystem\qr_trip_project" />
    <add key="DJANGO_SETTINGS_MODULE" value="qr_trip_project.settings" />
  </appSettings>
</configuration>